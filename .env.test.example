# Copy this file to .env.test and fill in real values. .env.test is
# gitignored — it must never be committed, and the service role key in it
# must never be pasted into Cloudflare Pages, a CI secret, or anywhere else
# outside this one local file. See README.md "Automated RLS tests" for why.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key (Supabase dashboard -> Project Settings -> API -> service_role).
# This key bypasses every RLS policy in the database. It is required to
# create/confirm test users, seed fixtures across two organisations, and
# tear everything down afterward. The test suite refuses to run if this is
# missing rather than silently falling back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=
