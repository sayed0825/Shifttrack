# Sentry error monitoring (src/main.tsx). A Sentry DSN is not secret in the
# way an API key is — it is meant to be embedded in client-side code — but
# it is still environment-specific config, not something to hardcode.
# Must also be set in Cloudflare Pages' build environment variables, or
# production builds run with error reporting silently disabled.
VITE_SENTRY_DSN=
